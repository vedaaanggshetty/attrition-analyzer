# Copy this file to .env and fill in real values. .env is git-ignored.

# Root password for the single mysql-db container (hosts all three
# per-service databases - see docker/mysql/init-databases.sh)
MYSQL_ROOT_PASSWORD=

# authentication-service's database user (authentication_db)
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=

# user-profile-service's database user (user_profile_db)
PROFILE_DB_USERNAME=
PROFILE_DB_PASSWORD=

# notification-service's database user (notification_db)
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=

# Shared secret used to sign/verify JWTs (Authentication Service issues them,
# Notification Service verifies them) - must be the same value both services use.
JWT_SECRET=

# Optional: override the API base URL baked into the frontend's build if the
# Gateway isn't reachable at the default http://localhost:8080 from the
# browser. Must be a browser-reachable address, never a Docker-internal name.
VITE_API_BASE_URL=
