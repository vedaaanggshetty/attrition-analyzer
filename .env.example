# MySQL root password (used only for container bootstrap/healthcheck)
MYSQL_ROOT_PASSWORD=password

# Authentication Service database credentials (authentication_db)
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3306
AUTH_DB_NAME=authentication_db
AUTH_DB_USERNAME=db-admin
AUTH_DB_PASSWORD=admin

# User Profile Service database credentials (user_profile_db)
PROFILE_DB_HOST=localhost
PROFILE_DB_PORT=3306
PROFILE_DB_NAME=user_profile_db
PROFILE_DB_USERNAME=changeme-profile-user
PROFILE_DB_PASSWORD=changeme-profile-password

# Shared JWT signing secret (Authentication signs, User Profile only validates).
# Must be identical across both services. Use a long random string in real .env.
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_EXPIRATION_MS=3600000
